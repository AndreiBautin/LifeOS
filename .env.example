# Every variable the app reads. Copy to .env.local to override locally.
#
# Vite exposes any variable prefixed VITE_ to the browser bundle. That
# prefix makes a value PUBLIC — it is compiled into JavaScript that
# anyone can read. Never put a credential behind it. This app has no
# credentials, which is why every variable here is safe to publish.

# Where the app is served from. "/" locally; "/<repo>/" for a GitHub
# project page. Both the bundler's asset paths and the router's basename
# derive from this single value.
VITE_BASE_PATH=/

# "true" switches storage to a separate namespace, so a demo build can
# never see or overwrite real training data.
VITE_DEMO_MODE=false

# debug | info | warn | error | silent. An unrecognised value falls back
# to the default rather than being trusted, so a typo cannot silently
# enable debug logging in production.
VITE_LOG_LEVEL=debug

# Shown in Settings so a deployed page can be tied back to a commit.
# Injected by CI; leave unset locally.
# VITE_APP_VERSION=
# VITE_COMMIT_SHA=

# --- Sync (optional) ---------------------------------------------------
#
# Leave every one of these unset and the app behaves exactly as it did
# before sync existed: everything stays on the device, and the Settings
# screen says so. Set all four to sync a phone and a desktop through your
# own Firebase project.
#
# These are PUBLIC, and that is not a compromise — a Firebase web config
# identifies a project, it does not authorise anything. Access is decided
# entirely by firestore.rules, which pins every document to the account
# that owns it. Do not go looking for a secret to add here; there isn't
# one, and anything you did add would be readable in the bundle.
#
# Partial configuration is treated as a mistake rather than as "off":
# the app reports which variables are missing instead of starting a
# client that fails on the first write.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Who may open the app (optional) -----------------------------------
#
# Firebase account ids, comma-separated. Unset means no gate: anyone who
# opens the page gets a working app against their own device storage,
# which is how this behaved before the gate existed.
#
# Set it and the app refuses anybody not named here. This is a lock on
# *using the app*, not on the data: the synced data is held by
# firestore.rules and the device's own storage belongs to whoever holds
# the device. It is also not a lock on the phone — a session persists, so
# an unlocked device opens straight through.
#
# A uid is PUBLIC, like every VITE_ value. It names an account and
# authorises nothing. Use the same id that appears in firestore.rules; if
# the two disagree, an account can open the app and cannot sync.
#
# It fails OPEN on an empty value, deliberately — a gate that bricked the
# app for want of a variable would be worse than no gate, and there is
# nothing behind it that failing closed would protect.
# VITE_ALLOWED_UIDS=
