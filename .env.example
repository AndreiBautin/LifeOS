# Every variable the app reads. Copy to .env.local to override locally.
#
# Vite exposes any variable prefixed VITE_ to the browser bundle. That
# prefix makes a value PUBLIC — it is compiled into JavaScript that
# anyone can read. Never put a credential behind it. This app has no
# credentials, which is why every variable here is safe to publish.

# Where the app is served from. "/" locally; "/<repo>/" for a GitHub
# project page. Both the bundler's asset paths and the router's basename
# derive from this single value.
VITE_BASE_PATH=/

# "true" switches storage to a separate namespace, so a demo build can
# never see or overwrite real training data.
VITE_DEMO_MODE=false

# debug | info | warn | error | silent. An unrecognised value falls back
# to the default rather than being trusted, so a typo cannot silently
# enable debug logging in production.
VITE_LOG_LEVEL=debug

# Shown in Settings so a deployed page can be tied back to a commit.
# Injected by CI; leave unset locally.
# VITE_APP_VERSION=
# VITE_COMMIT_SHA=
