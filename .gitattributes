# Normalize every text file to LF in the repository *and* in the working
# tree on every platform.
#
# Without this, a Windows checkout gets CRLF, Prettier (which defaults to
# LF) fails locally, and CI on Linux passes anyway — a formatting gate
# that only one operating system can satisfy. `eol=lf` overrides
# core.autocrlf, so the check means the same thing everywhere.
* text=auto eol=lf

# Binary and generated files: never touched, never diffed as text.
*.svg    text eol=lf
*.png    binary
*.ico    binary
*.woff   binary
*.woff2  binary
pnpm-lock.yaml linguist-generated=true

# start.bat is run by cmd.exe on Windows, which is happiest with CRLF.
start.bat text eol=crlf
