#!/bin/sh
#
# Runs the full verification pipeline before anything leaves this machine.
#
# CI runs the same checks, but CI runs *after* the push — and the deploy
# workflow publishes from main. Catching a failure here means the broken
# commit never exists on the remote, rather than existing and being
# reverted.
#
# Bypass for a genuine emergency:   git push --no-verify
# (CI will still catch it, and the deploy is gated on CI.)

set -e

printf '\n[pre-push] Running pnpm verify — typecheck, lint, format, tests, build.\n'
printf '[pre-push] Bypass with --no-verify if you must.\n\n'

if ! command -v pnpm >/dev/null 2>&1; then
  printf '[pre-push] pnpm not found on PATH; skipping verification.\n'
  exit 0
fi

if ! pnpm verify; then
  printf '\n[pre-push] BLOCKED — verification failed. Fix the above, or push with --no-verify.\n\n'
  exit 1
fi

printf '\n[pre-push] All checks passed. Pushing.\n\n'
